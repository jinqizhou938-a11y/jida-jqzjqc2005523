PORT=3001
NODE_ENV=development

# 智谱 AI 视觉分析（GLM-4V）
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_VISION_MODEL=glm-4v-flash

# 通义万相 试穿预览（Wan2.7-Image-Pro 多图编辑）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
WANX_IMAGE_MODEL=wan2.7-image-pro
WANX_IMAGE_SIZE=2K
WAN27_THINKING_MODE=true

# 旧版 wanx-v1 回退参数（仅当 WANX_IMAGE_MODEL=wanx-v1 时生效）
WANX_REF_STRENGTH=0.38
WANX_REF_MODE=repaint
WANX_IMAGE_STYLE=<photography>

# CORS
FRONTEND_URL=http://localhost:5173
